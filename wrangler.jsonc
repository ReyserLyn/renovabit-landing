{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "renovabit-landing",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-07-09",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page"
	},
	"ratelimits": [
		{
			"name": "CONTACT_RATE_LIMITER",
			"namespace_id": "2001",
			"simple": {
				"limit": 3,
				"period": 60
			}
		}
	],
	"routes": [
		{
			"pattern": "renovabit.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}
