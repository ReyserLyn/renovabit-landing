# Variables de entorno públicas de RenovaBit.
# IMPORTANTE: se leen en tiempo de BUILD (no en runtime). Cambiarlas exige un nuevo build.
# Copia este archivo a `.env` para desarrollo local.

# Clave de Google Maps JavaScript API (mapa interactivo de /contacto/).
PUBLIC_GOOGLE_MAPS_API_KEY=tu-api-key-de-google-maps

# Permite indexar el sitio en buscadores. Usar "false" para builds no indexables.
PUBLIC_INDEXABLE=true

# Habilita Umami Analytics. Definirla como "true" en el build de producción.
PUBLIC_UMAMI_ENABLED=true

# Sitekey pública de Cloudflare Turnstile para el formulario de /contacto/.
# En desarrollo funciona la sitekey de prueba (siempre pasa). En producción
# reemplázala por la sitekey real de tu widget y vuelve a construir: es una
# variable de BUILD (ver docs/contact-form.md).
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
