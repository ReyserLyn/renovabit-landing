{
	"name": "renovabit-landing",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "wrangler types && astro dev",
		"build": "wrangler types && astro check && astro build",
		"check": "astro check",
		"check:biome": "biome check . --write",
		"preview": "wrangler types && astro preview",
		"test": "bun test",
		"verify": "bunx biome check . && bun test && bun run check && bun run build",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply renovabit-landing-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply renovabit-landing-db --remote",
		"resenas:sync": "bun scripts/sync-resenas.ts",
		"cf:types": "wrangler types",
		"cf:deploy": "astro build && wrangler deploy"
	},
	"dependencies": {
		"@astroanimate/core": "^0.1.2",
		"@astrojs/cloudflare": "^14.3.1",
		"@astrojs/preact": "^6.0.5",
		"@astrojs/rss": "^4.0.19",
		"@data-slot/accordion": "^0.2.167",
		"@data-slot/tooltip": "^0.2.167",
		"@formisch/preact": "^1.1.0",
		"@googlemaps/js-api-loader": "^2.1.1",
		"@jdevalk/astro-seo-graph": "^2.2.0",
		"@preact/signals": "^2.11.2",
		"@tailwindcss/typography": "^0.5.20",
		"class-variance-authority": "^0.7.1",
		"cnfast": "^0.2.0",
		"drizzle-orm": "^0.45.2",
		"preact": "^10.29.8",
		"tailwind-animations": "^1.0.2",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/sitemap": "^3.7.4",
		"@biomejs/biome": "2.4.16",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@iconify-json/hugeicons": "^1.2.35",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.2",
		"@types/google.maps": "^3.66.3",
		"astro": "7.3.2",
		"astro-icon": "^1.2.0",
		"astro-llms-md": "^3.0.2",
		"drizzle-kit": "^0.31.10",
		"lefthook": "^2.1.14",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"wrangler": "^4.132.0"
	}
}
