---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import WhatsappIcon from "@/components/social-icon/WhatsappIcon.astro";
import { Button } from "@/components/ui/button";
import { CONTACT } from "@/constants";
import { servicioTecnicoCommercial } from "@/data/servicio-tecnico";

interface Props {
	heroImg: ImageMetadata;
	symptoms: string[];
	ctaLabel: string;
}

const { heroImg, symptoms, ctaLabel } = Astro.props;
const checkIcon = "hugeicons:checkmark-circle-03";
const checkIconClass = "mt-0.5 size-3.5 shrink-0 text-primary/60";
---

<!-- Tarifas -->
<section class="border-t py-16 md:py-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-16">
			<div
				class="-mx-4 overflow-hidden sm:mx-0 sm:rounded-2xl sm:border sm:border-border/20 lg:sticky lg:top-24"
			>
				<Image
					src={heroImg}
					alt="Mantenimiento profesional de laptop en RenovaBit"
					widths={[600, 800]}
					sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 50vw"
					loading="lazy"
					class="aspect-4/3 w-full object-cover"
				/>
			</div>

			<div>
				<h2 class="font-heading text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
					Tarifas claras según tu equipo
				</h2>
				<p class="mt-4 text-base leading-relaxed text-muted-foreground">
					Elige entre atención en taller o a domicilio. La visita a domicilio suma S/30 y se
					coordina previamente.
				</p>

				<div class="mt-8 overflow-hidden rounded-xl border border-border/30">
					<div
						class="grid grid-cols-[1.4fr_0.7fr_0.7fr] bg-muted/30 px-4 py-3 text-[11px] font-semibold tracking-wider text-muted-foreground uppercase sm:px-5"
					>
						<span>Equipo</span>
						<span>Taller</span>
						<span>Domicilio</span>
					</div>
					{servicioTecnicoCommercial.prices.map((row) => (
						<div class="grid grid-cols-[1.4fr_0.7fr_0.7fr] gap-2 border-t border-border/20 px-4 py-4 sm:px-5">
							<div>
								<p class="text-sm font-semibold text-foreground">{row.device}</p>
								<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{row.description}</p>
							</div>
							<p class="font-mono text-sm font-bold text-foreground">{row.workshop}</p>
							<p class="font-mono text-sm font-bold text-primary">{row.home}</p>
						</div>
					))}
				</div>

				<p class="mt-3 text-xs text-muted-foreground">
					Las reparaciones no están incluidas en estas tarifas: se derivan a taller y se cotizan
					después de evaluar el equipo.
				</p>

				<div class="mt-6">
					<Button
						as="a"
						href={CONTACT.whatsappUrl}
						target="_blank"
						rel="noopener noreferrer"
						variant="whatsapp"
						size="lg"
						class="gap-2"
					>
						<WhatsappIcon size={18} />{ctaLabel}
					</Button>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- Síntomas -->
<section class="bg-muted/15 py-16 md:py-20">
	<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
		<h2 class="font-heading text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
			¿Tu equipo tiene estos síntomas?
		</h2>
		<p class="mt-4 text-base leading-relaxed text-muted-foreground">
			Si reconoces alguno, es momento de revisarlo antes de que la falla avance.
		</p>
		<div class="mt-8 grid gap-x-8 gap-y-3 sm:grid-cols-2">
			{symptoms.map((symptom) => (
				<p class="inline-flex items-start gap-2.5 text-sm text-muted-foreground">
					<Icon name={checkIcon} class={checkIconClass} />{symptom}
				</p>
			))}
		</div>
		<div class="mt-8">
			<Button
				as="a"
				href={CONTACT.whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
				variant="outline"
				size="lg"
				class="gap-2"
			>
				Sí, eso me pasa <WhatsappIcon size={16} />
			</Button>
		</div>
	</div>
</section>

<!-- Incluye, no incluye y condiciones -->
<section class="border-t py-16 md:py-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-10 md:grid-cols-3 md:gap-8">
			<div>
				<h2 class="font-heading text-2xl font-bold tracking-tight text-foreground">Incluye</h2>
				<ul class="mt-6 space-y-3">
					{servicioTecnicoCommercial.included.map((item) => (
						<li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted-foreground">
							<Icon name={checkIcon} class={checkIconClass} />{item}
						</li>
					))}
				</ul>
			</div>
			<div>
				<h2 class="font-heading text-2xl font-bold tracking-tight text-foreground">No incluye</h2>
				<ul class="mt-6 space-y-3">
					{servicioTecnicoCommercial.excluded.map((item) => (
						<li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted-foreground">
							<Icon name="hugeicons:information-circle" class={checkIconClass} />{item}
						</li>
					))}
				</ul>
			</div>
			<div>
				<h2 class="font-heading text-2xl font-bold tracking-tight text-foreground">Condiciones</h2>
				<ul class="mt-6 space-y-3">
					{servicioTecnicoCommercial.conditions.map((item) => (
						<li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted-foreground">
							<Icon name="hugeicons:information-circle" class={checkIconClass} />{item}
						</li>
					))}
				</ul>
			</div>
		</div>
	</div>
</section>

<!-- Cómo trabajamos -->
<section class="bg-muted/15 py-16 md:py-20">
	<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
		<h2 class="font-heading text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
			Cómo trabajamos
		</h2>
		<p class="mt-4 text-base leading-relaxed text-muted-foreground">
			Primero revisamos el equipo y confirmamos qué servicio corresponde. Si encontramos una
			reparación, la derivamos a taller y te enviamos una cotización antes de continuar.
		</p>
		<div class="mt-8">
			<Button
				as="a"
				href={CONTACT.whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
				variant="whatsapp"
				size="lg"
				class="gap-2"
			>
				<WhatsappIcon size={18} />{ctaLabel}
			</Button>
		</div>
	</div>
</section>
