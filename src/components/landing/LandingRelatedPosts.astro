---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

interface Props {
	heading?: string;
	subtitle?: string;
	limit?: number;
	tone?: "white" | "muted";
	bordered?: boolean;
}

const {
	heading = "Artículos relacionados",
	subtitle,
	limit = 2,
	tone = "white",
	bordered = true,
} = Astro.props;

const posts = (await getCollection("blog", ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
	.slice(0, limit);

if (posts.length === 0) return;

const isMuted = tone === "muted";

function formatDate(date: Date): string {
	return date.toLocaleDateString("es-PE", { day: "numeric", month: "short", year: "numeric" });
}
---

<section class:list={["py-12 md:py-16", isMuted && "bg-muted/15", bordered && "border-t"]}>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div class="max-w-2xl">
				<h2 class="font-heading text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
					{heading}
				</h2>
				{subtitle && <p class="mt-2 text-base leading-relaxed text-muted-foreground">{subtitle}</p>}
			</div>
			<a
				href="/blog/"
				class="inline-flex items-center gap-1 font-medium text-primary hover:underline"
			>
				Ver el blog
				<Icon name="hugeicons:arrow-right-01" class="size-4" />
			</a>
		</div>
		<ul class="mt-8 divide-y divide-border/20 border-y border-border/20">
			{posts.map((post) => (
				<li>
					<a
						href={`/blog/${post.id}/`}
						class="group flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
					>
						<span class="font-heading text-base font-bold text-foreground transition-colors group-hover:text-primary group-hover:underline sm:text-lg">
							{post.data.title}
						</span>
						<span class="flex shrink-0 items-center gap-1.5 font-mono text-xs text-muted-foreground">
							<time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
							<Icon name="hugeicons:arrow-up-right-01" class="size-3.5 text-primary" aria-hidden="true" />
						</span>
					</a>
				</li>
			))}
		</ul>
	</div>
</section>
