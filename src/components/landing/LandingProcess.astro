---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import LandingSectionHeader from "@/components/landing/LandingSectionHeader.astro";

export interface LandingStepItem {
	title: string;
	description: string;
	image?: ImageMetadata;
	imageAlt?: string;
}

interface Props {
	eyebrow?: string;
	heading: string;
	subtitle?: string;
	steps: readonly LandingStepItem[];
	tone?: "white" | "muted";
	bordered?: boolean;
	marker?: "primary" | "outline";
}

const {
	eyebrow,
	heading,
	subtitle,
	steps,
	tone = "white",
	bordered = true,
	marker = "primary",
} = Astro.props;
const isMuted = tone === "muted";
const isOutlineMarker = marker === "outline";
const hasImages = steps.some((step) => step.image);
const markerClass = [
	"flex shrink-0 items-center justify-center font-mono text-xs",
	isOutlineMarker
		? "size-7 rounded-full border border-border/30 font-medium text-muted-foreground"
		: "size-8 rounded-full bg-primary font-bold text-primary-foreground",
];
---

<section class:list={["py-16 md:py-20", isMuted && "bg-muted/15", bordered && "border-t"]}>
	<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
		<LandingSectionHeader eyebrow={eyebrow} heading={heading} subtitle={subtitle} />
		<ol
			class:list={[hasImages ? "mt-14 flex flex-col gap-16 md:gap-20" : "mt-10", !hasImages && (isOutlineMarker ? "space-y-8" : "space-y-7")]}
		>
			{steps.map((step, index) =>
				step.image ? (
					<li
						class="grid items-center gap-6 md:grid-cols-12 md:gap-10 animate-fade-in-up view-animate-[--entrance] animate-duration-slower"
					>
						<div
							class="w-3/4 mx-auto md:col-span-5 md:w-full"
							class:list={[index % 2 === 0 ? "" : "md:order-2"]}
						>
							<div class="overflow-hidden rounded-2xl border border-border/20">
								<Image
									src={step.image}
									alt={step.imageAlt ?? step.title}
									widths={[400, 800]}
									sizes="(max-width: 768px) 75vw, 42vw"
									loading="lazy"
									decoding="async"
									class="aspect-4/3 w-full object-cover"
								/>
							</div>
						</div>
						<div class="md:col-span-7" class:list={[index % 2 === 0 ? "" : "md:order-1"]}>
							<span class:list={markerClass}>{index + 1}</span>
							<h3 class="mt-4 font-heading text-xl font-bold tracking-tight text-foreground sm:text-2xl">
								{step.title}
							</h3>
							<p class="mt-2 text-sm leading-relaxed text-muted-foreground sm:text-base">
								{step.description}
							</p>
						</div>
					</li>
				) : (
					<li class="flex gap-4">
						<span class:list={markerClass}>{index + 1}</span>
						<div>
							<h3
								class:list={[
									"font-heading font-bold text-foreground",
									isOutlineMarker && "text-base",
								]}
							>
								{step.title}
							</h3>
							<p class="mt-1 text-sm leading-relaxed text-muted-foreground">
								{step.description}
							</p>
						</div>
					</li>
				),
			)}
		</ol>
	</div>
</section>
