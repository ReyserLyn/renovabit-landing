---
import ContactFormSection from "@/components/contact/ContactFormSection.astro";
import type { LandingInternalLink } from "@/data/landings";

interface Props {
	heading: string;
	description: string;
	ctaLabel: string;
	umamiEvent: string;
	/** Mensaje precargado de WhatsApp para contextualizar el CTA. */
	waMessage?: string;
	internalLinks?: readonly LandingInternalLink[];
}

const { heading, description, ctaLabel, umamiEvent, waMessage, internalLinks } = Astro.props;

const links = internalLinks ?? [];
const linkSegments = links.flatMap((link, index) => [
	...(index > 0 ? [{ text: index === links.length - 1 ? " y " : ", " }] : []),
	{ text: link.label, href: link.href },
]);
---

<ContactFormSection
	id="formulario"
	heading={heading}
	description={description}
	ctaLabel={ctaLabel}
	waMessage={waMessage}
	position={umamiEvent}
>
	{linkSegments.length > 0 && (
		<p class="text-sm leading-relaxed text-primary-foreground/80">
			También puedes conocer{' '}
			{linkSegments.map((segment) =>
				segment.href ? (
					<a
						href={segment.href}
						class="font-medium text-primary-foreground underline underline-offset-4 hover:text-white"
					>
						{segment.text}
					</a>
				) : (
					<span>{segment.text}</span>
				),
			)}.
		</p>
	)}
</ContactFormSection>
