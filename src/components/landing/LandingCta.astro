---
import WhatsappIcon from "@/components/social-icon/WhatsappIcon.astro";
import { Button } from "@/components/ui/button";
import { whatsappUrl } from "@/constants";
import type { LandingInternalLink } from "@/data/landings";

interface Props {
	heading: string;
	description: string;
	ctaLabel: string;
	umamiEvent: string;
	/** Mensaje precargado de WhatsApp para contextualizar el CTA. */
	waMessage?: string;
	internalLinks?: readonly LandingInternalLink[];
}

const { heading, description, ctaLabel, umamiEvent, waMessage, internalLinks } = Astro.props;

const links = internalLinks ?? [];
const linkSegments = links.flatMap((link, index) => [
	...(index > 0 ? [{ text: index === links.length - 1 ? " y " : ", " }] : []),
	{ text: link.label, href: link.href },
]);
---

<section class="border-t py-16 md:py-20">
	<div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
		<h2 class="font-heading text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
			{heading}
		</h2>
		<p class="mt-4 text-base leading-relaxed text-muted-foreground">{description}</p>
		<div class="mt-8">
			<Button
				as="a"
				href={whatsappUrl(waMessage)}
				target="_blank"
				rel="noopener noreferrer"
				variant="whatsapp"
				size="lg"
				class="gap-2"
				data-umami-event="whatsapp_click"
				data-umami-event-position={umamiEvent}
			>
				<WhatsappIcon size={18} />{ctaLabel}
			</Button>
		</div>
		{linkSegments.length > 0 && (
			<p class="mt-6 text-sm text-muted-foreground">
				También puedes conocer{' '}
				{linkSegments.map((segment) =>
					segment.href ? (
						<a href={segment.href} class="font-medium text-primary hover:underline">
							{segment.text}
						</a>
					) : (
						<span>{segment.text}</span>
					),
				)}.
			</p>
		)}
	</div>
</section>
