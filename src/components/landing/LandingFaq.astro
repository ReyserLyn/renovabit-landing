---
import FaqSection from "@/components/sections/FaqSection.astro";
import type { FaqItem } from "@/data/faq";

interface Props {
	items: readonly FaqItem[];
	heading?: string;
	subtitle?: string;
	/** Mensaje precargado de WhatsApp para el CTA de cierre. */
	waMessage?: string;
	/** Posición de Umami para el CTA de cierre (default: "faq"). */
	waPosition?: string;
}

const { items, heading = "Preguntas frecuentes", subtitle, waMessage, waPosition } = Astro.props;
---

<FaqSection
	items={items}
	heading={heading}
	subtitle={subtitle}
	variant="compact"
	waMessage={waMessage}
	waPosition={waPosition}
/>
