---
import { Icon } from "astro-icon/components";
import processImg1 from "@/assets/images/process/process-1.avif";
import processImg2 from "@/assets/images/process/process-2.avif";
import processImg3 from "@/assets/images/process/process-3.avif";
import processImg4 from "@/assets/images/process/process-4.avif";
import servicioImg1 from "@/assets/images/services/service-1.avif";
import LandingCta from "@/components/landing/LandingCta.astro";
import LandingFaq from "@/components/landing/LandingFaq.astro";
import LandingHero from "@/components/landing/LandingHero.astro";
import LandingPriceTable from "@/components/landing/LandingPriceTable.astro";
import LandingProcess from "@/components/landing/LandingProcess.astro";
import LandingRelatedPosts from "@/components/landing/LandingRelatedPosts.astro";
import LandingTestimonials from "@/components/landing/LandingTestimonials.astro";
import { servicioTecnicoCommercial } from "@/data/servicio-tecnico";
import { getTestimoniosByServicio } from "@/data/testimonios";
import BaseLayout from "@/layouts/BaseLayout.astro";

const { prices, faqs } = servicioTecnicoCommercial;
const testimonios = getTestimoniosByServicio("servicio-tecnico");
const standardIncludes = [
	"Limpieza interna y externa del equipo",
	"Cambio de pasta térmica",
	"Pruebas básicas de funcionamiento y temperatura",
	"Backup básico cuando el volumen y estado del equipo lo permiten",
];
const complexIncludes = [
	...standardIncludes.slice(0, 3),
	"Pads térmicos estándar incluidos",
	"Backup básico cuando el volumen y estado del equipo lo permiten",
];
---

<BaseLayout
	title="Mantenimiento de PC a Domicilio en Arequipa"
	description="Mantenimiento de PC y laptop a domicilio en Arequipa desde S/120. Tarifa fija, coordinación previa y precios claros según la complejidad del equipo."
	ogImage="/og-servicio-tecnico.jpeg"
>
	<LandingHero
		eyebrow="Mantenimiento a domicilio · Arequipa"
		h1="Mantenimiento de PC a domicilio en Arequipa"
		intro="Limpieza, pasta térmica y pruebas básicas para que tu laptop o PC vuelva a trabajar en mejores condiciones. Coordinamos la visita y confirmamos la tarifa antes de ir."
		ctaLabel="Coordinar por WhatsApp"
		umamiEvent="maintenance-home-hero"
		image={servicioImg1}
		imageAlt="Mantenimiento de laptop y PC realizado por RenovaBit en Arequipa"
		badge="Desde S/120 a domicilio"
		note="Domicilio suma S/30 a la tarifa de taller y requiere coordinación previa."
		secondary={{ href: "#precios", label: "Ver tarifas" }}
		floatingCard={{
			eyebrow: "La visita",
			title: "Tarifa fija según tu equipo",
			description: "Sin sumar un cargo distinto por la visita.",
		}}
	/>

	<LandingPriceTable
		eyebrow="Precios claros"
		heading="Elige la modalidad que necesitas"
		aside="El domicilio suma S/30 a cualquiera de las tarifas de taller."
		rows={prices}
		note="La atención a domicilio se agenda previamente. Reparaciones, repuestos y licencias no están incluidos."
	/>

	<section class="border-b py-16 md:py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="max-w-2xl">
				<p class="font-mono text-xs font-medium tracking-widest text-primary uppercase">
					Qué incluye
				</p>
				<h2 class="mt-3 font-heading text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
					El alcance depende de la complejidad
				</h2>
				<p class="mt-4 text-base leading-relaxed text-muted-foreground">
					La diferencia está en el tipo de equipo y el trabajo térmico que requiere. No agregamos
					reparaciones al mantenimiento.
				</p>
			</div>
			<div class="mt-10 grid gap-5 md:grid-cols-2">
				{[
					{ label: "Mantenimiento estándar", note: "Laptop o PC simple", items: standardIncludes },
					{ label: "Mantenimiento complejo", note: "Laptop gamer o PC compleja", items: complexIncludes },
				].map((tier, index) => (
					<article class:list={["rounded-2xl border p-6 sm:p-8", index === 1 ? "border-primary/30 bg-primary/4" : "border-border/30 bg-muted/15"]}>
						<div class="flex items-start justify-between gap-4">
							<div><h3 class="font-heading text-xl font-bold text-foreground">{tier.label}</h3><p class="mt-1 text-sm text-muted-foreground">{tier.note}</p></div>
							<span class="rounded-full bg-background px-3 py-1 font-mono text-xs font-medium text-primary">{index === 0 ? prices[0].workshop : prices[1].workshop}</span>
						</div>
						<ul class="mt-7 space-y-3">
							{tier.items.map((item) => <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted-foreground"><Icon name="hugeicons:checkmark-circle-03" class="mt-0.5 size-4 shrink-0 text-primary/70" />{item}</li>)}
						</ul>
					</article>
				))}
			</div>
		</div>
	</section>

	<LandingProcess
		eyebrow="Cómo funciona"
		heading="La visita se coordina antes de salir"
		steps={[
			{
				title: "Nos cuentas qué equipo tienes",
				description: "Indícanos si es laptop o PC, si es un equipo simple o gamer, y qué necesitas revisar.",
				image: processImg1,
				imageAlt:
					"Conversación de WhatsApp coordinando el mantenimiento a domicilio con RenovaBit en Arequipa: tipo de equipo y necesidad de revisión",
			},
			{
				title: "Confirmamos modalidad y tarifa",
				description: "Te orientamos sobre taller o domicilio. La visita a domicilio suma S/30 y se agenda previamente.",
				image: processImg4,
				imageAlt:
					"Proformas y cotizaciones RenovaBit en Arequipa: tarifas de mantenimiento en taller y a domicilio antes de coordinar la visita",
			},
			{
				title: "Realizamos el mantenimiento",
				description: "Limpiamos, cambiamos la pasta térmica cuando corresponde y hacemos pruebas básicas.",
				image: processImg3,
				imageAlt:
					"Antes y después del mantenimiento RenovaBit en Arequipa: limpieza interna y pasta térmica que devuelven el rendimiento a tu PC",
			},
			{
				title: "Te explicamos cualquier hallazgo",
				description: "Si encontramos una reparación, la derivamos a taller y la cotizamos después de evaluar el equipo.",
				image: processImg2,
				imageAlt:
					"Informe técnico RenovaBit en Arequipa: hallazgos del mantenimiento y evidencia fotográfica antes de cotizar una reparación",
			},
		]}
		tone="muted"
		bordered={false}
	/>

	<section class="border-t py-16 md:py-20">
		<div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
			<div>
				<p class="font-mono text-xs font-medium tracking-widest text-primary uppercase">
					Importante
				</p>
				<h2 class="mt-3 font-heading text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
					Si aparece una reparación
				</h2>
			</div>
			<div class="max-w-2xl space-y-4 text-base leading-relaxed text-muted-foreground">
				<p>
					El mantenimiento no incluye reparaciones. Si durante la revisión encontramos una falla, no
					la intervenimos como parte de la visita.
				</p>
				<p>
					La reparación se deriva a taller y se cotiza después de evaluar el equipo. Repuestos y
					licencias se cotizan aparte. El diagnóstico avanzado cuesta S/60 y se acredita si aceptas
					la reparación.
				</p>
				<a
					href="/reparacion-laptops-arequipa/"
					class="inline-flex items-center gap-1 font-medium text-primary hover:underline"
					>Ver reparación de laptops en Arequipa
					<Icon name="hugeicons:arrow-up-right-01" class="size-4" /></a
				>
			</div>
		</div>
	</section>

	<LandingTestimonials
		items={testimonios}
		eyebrow="Clientes"
		heading="Mantenimientos que dejan huella"
		subtitle="Experiencias reales de clientes con el servicio técnico en Arequipa."
	/>

	<LandingFaq
		items={faqs}
		heading="Preguntas sobre mantenimiento a domicilio"
		subtitle="Respuestas directas sobre tarifas, alcance y coordinación previa."
	/>

	<LandingCta
		heading="Coordina el mantenimiento de tu equipo"
		description="Escríbenos por WhatsApp con el tipo de equipo y si prefieres taller o domicilio. Confirmamos la tarifa antes de coordinar."
		ctaLabel="Coordinar por WhatsApp"
		umamiEvent="maintenance-home-final"
		internalLinks={[
			{ href: "/servicios/servicio-tecnico/", label: "el servicio técnico general" },
			{ href: "/laptop-lenta-arequipa/", label: "la guía de laptop lenta" },
		]}
	/>

	<LandingRelatedPosts
		heading="Artículos relacionados"
		subtitle="Guías y consejos para mantener tu equipo en buen estado."
	/>
</BaseLayout>
