---
import { ReviewForm } from "@/components/resena/ReviewForm";
import { resenaFormCopy } from "@/data/resena-form";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { contactSiteKey } from "@/lib/contact/site-key";

const turnstileSiteKey = contactSiteKey();
---

<BaseLayout
	title="Cuéntanos tu experiencia"
	description="Cuéntanos tu experiencia con RenovaBit y recibe un descuento de S/5 en el servicio que recibiste. Tu reseña se publica después de revisarla."
	noindex
>
	<!-- Hero -->
	<section class="pt-32 pb-8 md:pt-40 md:pb-10">
		<div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
			<p class="font-mono text-xs font-medium tracking-widest text-primary uppercase">
				Tu opinión cuenta
			</p>
			<h1 class="mt-3 font-heading text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
				{resenaFormCopy.heading}
			</h1>
			<p class="mt-4 text-lg leading-relaxed text-muted-foreground sm:text-xl">
				{resenaFormCopy.welcome}
			</p>
		</div>
	</section>

	<!-- Formulario -->
	<section class="pt-6 pb-20 md:pb-28">
		<div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
			<div class="rounded-2xl border border-border/40 bg-card p-6 shadow-sm sm:p-8">
				<ReviewForm siteKey={turnstileSiteKey} client:load />
			</div>
			<noscript>
				<p
					class="mt-6 rounded-lg border border-border bg-muted/40 p-4 text-sm leading-relaxed text-muted-foreground"
				>
					{resenaFormCopy.noscript}
				</p>
			</noscript>
		</div>
	</section>
</BaseLayout>
