---
import BaseLayout from "@/layouts/BaseLayout.astro";

const variants = [
	{
		id: "a7",
		file: "resena-a7",
		name: "A7 · Círculo con sombra",
		note: "Placa circular blanca con una sombra suave.",
		alt: "Código QR modelo A7 que abre el formulario de reseñas de RenovaBit",
	},
	{
		id: "a9",
		file: "resena-a9",
		name: "A9 · Squircle con sombra",
		note: "Placa de esquinas redondeadas con una sombra más visible.",
		alt: "Código QR modelo A9 que abre el formulario de reseñas de RenovaBit",
	},
];
---

<BaseLayout
	title="QR de reseñas"
	description="Materiales de tienda: códigos QR de RenovaBit para dejar reseñas. Descarga en SVG (imprenta) o PNG en alta resolución."
	noindex
>
	<section class="pt-32 pb-16 md:pt-40 md:pb-24">
		<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
			<div class="max-w-2xl">
				<p class="font-mono text-xs font-medium tracking-widest text-primary uppercase">
					Materiales de tienda
				</p>
				<h1 class="mt-3 font-heading text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
					QR de reseñas
				</h1>
				<p class="mt-4 text-lg leading-relaxed text-muted-foreground">
					Los dos modelos abren <strong class="text-foreground">renovabit.com/resena</strong>.
					Entrega el <strong class="text-foreground">SVG</strong> a la imprenta (calidad vectorial,
					sin pérdida a cualquier tamaño) o usa el <strong class="text-foreground">PNG</strong> de
					alta resolución para compartirlo.
				</p>
				<p class="no-print mt-3 text-sm text-muted-foreground">
					Consejo: esta página también imprime bien. Con Ctrl+P (o Cmd+P) sale una hoja con ambos
					códigos listos para recortar.
				</p>
			</div>

			<div class="qr-sheet mt-10 grid gap-8 sm:grid-cols-2">
				{variants.map((v) => (
						<article class="rounded-2xl border border-border/40 bg-card p-6 shadow-sm">
							<div class="rounded-xl border border-border/40 bg-white p-5">
								<img
									src={`/qr/${v.file}.svg`}
									alt={v.alt}
									width="1200"
									height="1200"
									class="mx-auto aspect-square w-full max-w-[340px]"
								/>
							</div>
							<h2 class="mt-5 font-heading text-xl font-semibold text-foreground">{v.name}</h2>
							<p class="mt-1 text-sm text-muted-foreground">{v.note}</p>
							<div class="no-print mt-4 flex flex-wrap gap-2">
								<button
									type="button"
									data-qr-zoom={`/qr/${v.file}.svg`}
									data-qr-alt={v.alt}
									class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-3 font-mono text-xs font-medium text-primary-foreground shadow-sm transition hover:bg-primary/90"
								>
									Ver en grande
								</button>
								<a
									href={`/qr/${v.file}.svg`}
									download={`renovabit-qr-resena-${v.id}.svg`}
									class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-5 py-3 font-mono text-xs font-medium text-foreground transition hover:border-primary/40"
								>
									SVG · para imprenta
								</a>
								<a
									href={`/qr/${v.file}.png`}
									download={`renovabit-qr-resena-${v.id}-2480.png`}
									class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-5 py-3 font-mono text-xs font-medium text-foreground transition hover:border-primary/40"
								>
									PNG · 2480 px
								</a>
							</div>
						</article>
					))}
			</div>
		</div>
	</section>

	<dialog
		id="qr-dialog"
		aria-label="Código QR en tamaño completo"
		class="m-auto max-h-none max-w-none border-0 bg-transparent p-0 backdrop:bg-black/70"
	>
		<div class="flex flex-col items-center gap-4">
			<img
				id="qr-dialog-img"
				src=""
				alt=""
				width="1200"
				height="1200"
				class="aspect-square w-[min(92vw,80vh)] rounded-2xl bg-white p-4 shadow-2xl"
			>
			<div class="flex flex-wrap items-center justify-center gap-2">
				<a
					id="qr-dialog-open"
					href="#"
					target="_blank"
					rel="noopener"
					class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-5 py-3 font-mono text-xs font-medium text-white transition hover:bg-white/20"
				>
					Abrir en pestaña nueva
				</a>
				<button
					id="qr-dialog-close"
					type="button"
					class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 font-mono text-xs font-medium text-foreground shadow-sm transition hover:bg-white/90"
				>
					Cerrar
				</button>
			</div>
		</div>
	</dialog>

	<script is:inline>
	const qrDialog = document.getElementById("qr-dialog");
	const qrDialogImg = document.getElementById("qr-dialog-img");
	const qrDialogOpen = document.getElementById("qr-dialog-open");
	const qrDialogClose = document.getElementById("qr-dialog-close");
	if (qrDialog && qrDialogImg && qrDialogOpen && qrDialogClose) {
		for (const button of document.querySelectorAll("[data-qr-zoom]")) {
			button.addEventListener("click", () => {
				const src = button.getAttribute("data-qr-zoom");
				if (!src) return;
				qrDialogImg.setAttribute("src", src);
				qrDialogImg.setAttribute("alt", button.getAttribute("data-qr-alt") ?? "Código QR");
				qrDialogOpen.setAttribute("href", src);
				qrDialog.showModal();
			});
		}
		qrDialogClose.addEventListener("click", () => qrDialog.close());
		qrDialog.addEventListener("click", (event) => {
			if (event.target === qrDialog) qrDialog.close();
		});
	}
	</script>
</BaseLayout>

<style is:global>
@media print {
	@page {
		margin: 1.2cm;
	}

	/* Oculta todo y deja visible solo la hoja de QRs (técnica de visibilidad). */
	body * {
		visibility: hidden;
	}

	.qr-sheet,
	.qr-sheet * {
		visibility: visible;
	}

	.qr-sheet {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		margin: 0 !important;
		gap: 1.2cm;
		grid-template-columns: 1fr 1fr !important;
	}

	.qr-sheet article {
		border: 0 !important;
		box-shadow: none !important;
	}

	.qr-sheet img {
		width: 8cm !important;
		max-width: none !important;
	}

	.no-print {
		display: none !important;
	}

	dialog {
		display: none !important;
	}
}
</style>
