---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
	(a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const featured = sortedPosts.find((p) => p.data.featured);
const posts = featured ? sortedPosts.filter((p) => p.id !== featured.id) : sortedPosts;

function readingTime(body: string): string {
	const words = body.trim().split(/\s+/).length;
	const min = Math.max(1, Math.ceil(words / 200));
	return `${min} min de lectura`;
}

function formatDate(date: Date): string {
	return date.toLocaleDateString("es-PE", { year: "numeric", month: "long", day: "numeric" });
}
---

<BaseLayout
	title="Blog de Tecnología y Servicio Técnico"
	description="Artículos sobre mantenimiento de laptops, reparación de PCs, desarrollo web y tecnología. Consejos prácticos para mantener tus equipos en buen estado."
>
	<!-- Hero -->
	<section class="pt-32 pb-12 md:pt-40 md:pb-16">
		<div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
			<p class="font-mono text-xs font-medium tracking-widest text-primary uppercase">Blog</p>
			<h1
				class="mt-3 font-heading text-4xl font-bold tracking-tight text-foreground sm:text-5xl lg:text-6xl"
			>
				Tecnología sin vueltas
			</h1>
			<p class="mt-4 text-lg leading-relaxed text-muted-foreground sm:text-xl">
				Consejos prácticos, guías y respuestas directas sobre mantenimiento de laptops, reparación y
				desarrollo web. Sin tecnicismos innecesarios.
			</p>
		</div>
	</section>

	<!-- Featured post -->
	{featured && (
		<section class="border-t py-16 md:py-20">
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<p class="font-mono text-[11px] font-medium tracking-widest text-muted-foreground uppercase">Destacado</p>

				<a href={`/blog/${featured.id}/`} class="group mt-4 grid gap-8 lg:grid-cols-2 lg:gap-12">
					<div class="overflow-hidden rounded-2xl border border-border/20">
						<Image
							src={featured.data.heroImage}
							alt={featured.data.title}
							widths={[600, 900]}
							sizes="(max-width: 1024px) 100vw, 50vw"
							loading="eager"
							class="w-full object-cover aspect-video transition-transform duration-500 group-hover:scale-105"
						/>
					</div>

					<div class="flex flex-col justify-center">
						<div class="flex items-center gap-3 text-xs text-muted-foreground">
							{featured.data.tags.slice(0, 2).map((tag) => (
								<span class="rounded bg-primary/10 px-2 py-0.5 text-[10px] font-semibold text-primary uppercase tracking-wider">
									{tag}
								</span>
							))}
							<span aria-hidden="true">·</span>
							<time datetime={featured.data.publishDate.toISOString()}>{formatDate(featured.data.publishDate)}</time>
							<span aria-hidden="true">·</span>
							<span>{readingTime(featured.body ?? "")}</span>
						</div>

						<h2 class="mt-4 font-heading text-2xl font-bold leading-tight text-foreground transition-colors group-hover:text-primary sm:text-3xl">
							{featured.data.title}
						</h2>
						<p class="mt-3 text-base leading-relaxed text-muted-foreground">
							{featured.data.description}
						</p>

						<span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-primary">
							Leer artículo
							<Icon name="hugeicons:arrow-right-01" class="size-4" />
						</span>
					</div>
				</a>
			</div>
		</section>
	)}

	<!-- Posts grid -->
	<section class:list={["py-16 md:py-20", featured ? "border-t" : "border-t"]}>
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			{posts.length === 0 ? (
				<div class="py-20 text-center">
					<p class="text-base text-muted-foreground">Pronto publicaremos más artículos. ¡Vuelve en unos días!</p>
				</div>
			) : (
				<>
					<h2 class="font-heading text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
						Más artículos
					</h2>
					<div class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
						{posts.map((post) => (
							<a href={`/blog/${post.id}/`} class="group block">
								<div class="overflow-hidden rounded-2xl border border-border/20">
									<Image
										src={post.data.heroImage}
										alt={post.data.title}
										widths={[400, 600]}
										sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
										loading="lazy"
										class="w-full object-cover aspect-video transition-transform duration-500 group-hover:scale-105"
									/>
								</div>

								<div class="mt-4 flex items-center gap-2 text-xs text-muted-foreground">
									<time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
									<span aria-hidden="true">·</span>
									<span>{readingTime(post.body ?? "")}</span>
								</div>

								<h3 class="mt-2 font-heading text-lg font-bold leading-snug text-foreground transition-colors group-hover:text-primary">
									{post.data.title}
								</h3>
								<p class="mt-2 text-sm leading-relaxed text-muted-foreground line-clamp-2">
									{post.data.description}
								</p>

								{post.data.tags.length > 0 && (
									<div class="mt-3 flex flex-wrap gap-1.5">
										{post.data.tags.map((tag) => (
											<span class="rounded bg-primary/10 px-2 py-0.5 text-[10px] font-semibold text-primary uppercase tracking-wider">
												{tag}
											</span>
										))}
									</div>
								)}
							</a>
						))}
					</div>
				</>
			)}
		</div>
	</section>
</BaseLayout>
