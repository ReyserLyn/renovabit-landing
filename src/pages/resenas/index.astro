---
/**
 * Página pública de reseñas.
 *
 * Estática: se genera en el build con el artefacto que produce
 * `bun run resenas:sync`. Si todavía no hay reseñas aprobadas, muestra un estado
 * vacío honesto en lugar de ocultar la página. Entra al sitemap.
 */
import ReviewsSection from "@/components/resenas/ReviewsSection.astro";
import WhatsappIcon from "@/components/social-icon/WhatsappIcon.astro";
import { Button } from "@/components/ui/button";
import { Rating } from "@/components/ui/rating";
import { whatsappUrl } from "@/constants";
import { resenasPublicas } from "@/data/resenas.generated";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { calcularResumenPublico } from "@/lib/resenas/public";

const resumen = calcularResumenPublico(resenasPublicas);
---

<BaseLayout
	title="Reseñas de clientes | RenovaBit"
	description="Reseñas reales de clientes de RenovaBit en Arequipa: servicio técnico, reparación de laptops, mantenimiento y desarrollo web. Conoce sus experiencias."
>
	<!-- ===== Hero ===== -->
	<section class="pt-32 pb-10 md:pt-40 md:pb-14">
		<div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
			<p class="font-mono text-xs font-medium tracking-widest text-primary uppercase">
				Opiniones reales
			</p>
			<h1 class="mt-3 font-heading text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
				Reseñas de clientes
			</h1>
			<p class="mt-4 text-lg leading-relaxed text-muted-foreground sm:text-xl">
				Cada reseña la escribe una persona que ya trabajó con nosotros y la revisamos antes de
				publicarla. Acá están todas, sin recortes.
			</p>

			{resumen.total > 0 && resumen.promedio !== null && (
				<div class="mt-8 inline-flex flex-wrap items-center justify-center gap-x-6 gap-y-3 rounded-2xl border border-border/40 bg-card px-6 py-4">
					<div class="flex items-center gap-2.5">
						<Rating stars={resumen.promedio} size={20} />
						<span class="font-heading text-xl font-bold text-foreground">
							{resumen.promedio.toFixed(1)}
						</span>
					</div>
					<p class="text-sm text-muted-foreground">
						{resumen.total === 1 ? "1 reseña publicada" : `${resumen.total} reseñas publicadas`}
					</p>
				</div>
			)}
		</div>
	</section>

	<!-- ===== Estado vacío ===== -->
	{resumen.total === 0 && (
		<section class="pb-20 md:pb-28">
			<div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
				<div class="rounded-2xl border border-border/40 bg-card p-8 text-center sm:p-10">
					<h2 class="font-heading text-xl font-bold text-foreground">
						Todavía no hay reseñas publicadas
					</h2>
					<p class="mt-3 text-sm leading-relaxed text-muted-foreground">
						Estamos reuniendo las primeras opiniones de nuestros clientes. Si ya trabajaste con
						nosotros, cuéntanos tu experiencia: la revisamos y la publicamos acá.
					</p>
					<div class="mt-6 flex flex-wrap justify-center gap-3">
						<Button as="a" href="/resena/">Dejar mi reseña</Button>
						<Button
							as="a"
							href={whatsappUrl("Hola, quiero consultar por un servicio.")}
							variant="outline"
							target="_blank"
							rel="noopener noreferrer"
							class="gap-2"
						>
							<WhatsappIcon size={16} />
							Escríbenos
						</Button>
					</div>
				</div>
			</div>
		</section>
	)}

	<!-- ===== Listado completo y CTA ===== -->
	{resumen.total > 0 && (
		<>
			<ReviewsSection titulo="Opiniones publicadas" />

			<section class="pb-20 md:pb-28">
				<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
					<div
						class="flex flex-col items-center gap-8 rounded-2xl bg-primary px-6 py-12 text-center sm:px-10 sm:py-14 md:flex-row md:justify-between md:text-left lg:px-14 lg:py-16"
					>
						<div class="max-w-xl">
							<h2
								class="font-heading text-2xl font-bold tracking-tight text-primary-foreground sm:text-3xl"
							>
								¿Ya trabajaste con nosotros?
							</h2>
							<p class="mt-4 text-base leading-relaxed text-primary-foreground sm:text-lg">
								Cuéntanos tu experiencia y te damos un descuento de S/5 en el servicio que
								recibiste.
							</p>
						</div>

						<div class="flex shrink-0 flex-wrap justify-center gap-3">
							<Button
								as="a"
								href="/resena/"
								variant="default"
								size="lg"
								class="border border-white/20 bg-white text-primary hover:bg-white/90"
							>
								Dejar mi reseña
							</Button>
							<Button
								as="a"
								href={whatsappUrl("Hola, quiero consultar por un servicio.")}
								variant="outline"
								size="lg"
								target="_blank"
								rel="noopener noreferrer"
								class="gap-2 border-white/40 bg-transparent text-primary-foreground hover:bg-white/10"
							>
								<WhatsappIcon size={18} />
								Escríbenos
							</Button>
						</div>
					</div>
				</div>
			</section>
		</>
	)}
</BaseLayout>
