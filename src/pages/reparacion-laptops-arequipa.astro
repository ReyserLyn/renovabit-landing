---
import { Image } from "astro:assets";
import aboutImg2 from "@/assets/images/about/about-2.avif";
import processImg1 from "@/assets/images/process/process-1.avif";
import processImg2 from "@/assets/images/process/process-2.avif";
import servicioImg1 from "@/assets/images/services/service-1.avif";
import servicioImg4 from "@/assets/images/services/service-4.avif";
import LandingCta from "@/components/landing/LandingCta.astro";
import LandingFaq from "@/components/landing/LandingFaq.astro";
import LandingProcess from "@/components/landing/LandingProcess.astro";
import LandingRelatedPosts from "@/components/landing/LandingRelatedPosts.astro";
import LandingSymptoms from "@/components/landing/LandingSymptoms.astro";
import LandingTestimonials from "@/components/landing/LandingTestimonials.astro";
import WhatsappIcon from "@/components/social-icon/WhatsappIcon.astro";
import { Button } from "@/components/ui/button";
import { whatsappUrl } from "@/constants";
import { getFaqsForService } from "@/data/faq";
import { getTestimoniosByServicio } from "@/data/testimonios";
import BaseLayout from "@/layouts/BaseLayout.astro";

const faqs = getFaqsForService("reparacion-laptops-arequipa");
const waMessage = "Hola, necesito reparar mi laptop.";
const testimonios = getTestimoniosByServicio("servicio-tecnico");
const checkIcon = "hugeicons:checkmark-circle-03";
---

<BaseLayout
	title="Reparación de Laptops en Arequipa"
	description="Reparación de laptops en Arequipa con diagnóstico claro antes de intervenir. Revisamos fallas de encendido, temperatura, batería, pantalla y más."
	ogImage="/og-servicio-tecnico.jpeg"
>
	<section class="pt-32 pb-16 md:pt-40 md:pb-24">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
				<div>
					<p class="font-mono text-xs font-medium tracking-widest text-primary uppercase">
						Reparación de laptops en Arequipa
					</p>
					<h1
						class="mt-4 font-heading text-4xl font-bold leading-tight tracking-tight text-foreground sm:text-5xl lg:text-6xl"
					>
						¿Tu laptop falla? Primero entendemos el problema.
					</h1>
					<p class="mt-5 max-w-xl text-lg leading-relaxed text-muted-foreground">
						Revisamos tu equipo, explicamos el diagnóstico y te damos una cotización antes de
						reparar. Sin cambiar piezas innecesariamente ni prometer una solución sin evaluar la
						falla.
					</p>
					<div class="mt-8">
						<Button
							as="a"
							href={whatsappUrl(waMessage)}
							target="_blank"
							rel="noopener noreferrer"
							variant="whatsapp"
							size="lg"
							class="gap-2"
							data-umami-event="whatsapp_click"
							data-umami-event-position="laptop-repair-hero"
						>
							<WhatsappIcon size={18} />Cuéntanos qué le pasa a tu laptop
						</Button>
					</div>
					<p class="mt-4 text-xs text-muted-foreground">
						Atención en Arequipa. La modalidad se coordina según la falla y tu zona.
					</p>
				</div>

				<div class="overflow-hidden rounded-2xl border border-border/20">
					<Image
						src={servicioImg1}
						alt="Herramientas y equipos de RenovaBit para reparar laptops en Arequipa"
						widths={[600, 900]}
						sizes="(max-width: 1024px) 100vw, 50vw"
						fetchpriority="high"
						loading="eager"
						class="aspect-4/3 w-full object-cover"
					/>
				</div>
			</div>
		</div>
	</section>

	<LandingSymptoms
		eyebrow="Señales concretas"
		heading="Una falla no siempre significa que necesitas otra laptop."
		items={[
			{ icon: checkIcon, text: "No enciende o se apaga solo" },
			{ icon: checkIcon, text: "Se calienta demasiado o hace ruido" },
			{ icon: checkIcon, text: "Está lenta aunque antes funcionaba bien" },
			{ icon: checkIcon, text: "La batería dura muy poco o no carga" },
			{ icon: checkIcon, text: "La pantalla, teclado o cargador fallan" },
			{ icon: checkIcon, text: "Necesita revisar un puerto, disco o memoria" },
		]}
		cta={{ label: "Sí, eso me pasa", umamiEvent: "laptop-repair-symptoms" }}
		waMessage={waMessage}
	/>

	<LandingProcess
		eyebrow="Cómo trabajamos"
		heading="Diagnóstico antes de tomar decisiones"
		steps={[
			{
				title: "Nos cuentas los síntomas",
				description: "Por WhatsApp revisamos qué ocurre, desde cuándo y cómo se usa el equipo.",
				image: processImg1,
				imageAlt:
					"Conversación de WhatsApp coordinando la reparación de una laptop con RenovaBit en Arequipa: síntomas y modelo del equipo",
			},
			{
				title: "Evaluamos la laptop",
				description: "Revisamos el equipo para identificar el origen de la falla y qué pruebas hacen falta.",
				image: aboutImg2,
				imageAlt:
					"Diagnóstico de una laptop en el taller de RenovaBit en Arequipa: revisión con multímetro para identificar el origen de la falla",
			},
			{
				title: "Te explicamos las opciones",
				description: "Recibes el diagnóstico, el alcance y la cotización antes de autorizar el trabajo.",
				image: processImg2,
				imageAlt:
					"Informe técnico RenovaBit en Arequipa: diagnóstico, alcance y cotización antes de autorizar la reparación de la laptop",
			},
			{
				title: "Reparamos y probamos",
				description: "Solo después de tu aprobación intervenimos y verificamos el funcionamiento del equipo.",
				image: servicioImg4,
				imageAlt:
					"Laptop reparada y probada por RenovaBit en Arequipa: placa y componentes internos revisados tras la intervención",
			},
		]}
		tone="muted"
		marker="outline"
	/>

	<section class="border-t py-16 md:py-20">
		<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
			<h2 class="font-heading text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
				Condiciones claras para reparar tu laptop
			</h2>
			<div class="mt-8 space-y-4 text-base leading-relaxed text-muted-foreground">
				<p>
					No iniciamos reparaciones adicionales sin explicarte el cambio y recibir tu aprobación.
				</p>
				<p>
					El costo depende de la falla, la complejidad y los repuestos. Cotizamos antes de
					intervenir.
				</p>
				<p>
					Si el equipo no resulta reparable o la reparación no conviene, te lo comunicamos con
					honestidad.
				</p>
				<p>
					Coordinamos atención a domicilio, recojo y entrega o revisión en taller según el caso.
					Confirma por WhatsApp la modalidad disponible para tu zona.
				</p>
			</div>
			<div class="mt-8">
				<Button
					as="a"
					href={whatsappUrl(waMessage)}
					target="_blank"
					rel="noopener noreferrer"
					variant="whatsapp"
					size="lg"
					class="gap-2"
					data-umami-event="whatsapp_click"
					data-umami-event-position="laptop-repair-conditions"
				>
					<WhatsappIcon size={18} />Solicitar diagnóstico por WhatsApp
				</Button>
			</div>
		</div>
	</section>

	<LandingTestimonials
		items={testimonios}
		eyebrow="Clientes"
		heading="Experiencias con nuestro servicio técnico"
		subtitle="Lo que cuentan quienes confiaron en RenovaBit para su equipo."
	/>

	<LandingFaq
		items={faqs}
		heading="Preguntas sobre reparación de laptops"
		subtitle="Respuestas directas antes de coordinar la revisión de tu equipo."
		waMessage={waMessage}
		waPosition="laptop-repair-faq"
	/>

	<LandingCta
		heading="Cuéntanos qué le pasa a tu laptop"
		description="Envíanos la marca, el modelo y los síntomas. Te orientamos sobre el siguiente paso por WhatsApp."
		ctaLabel="Escríbenos por WhatsApp"
		umamiEvent="laptop-repair-final"
		waMessage={waMessage}
		internalLinks={[
			{ href: "/servicios/servicio-tecnico/", label: "el servicio técnico general" },
			{ href: "/laptop-lenta-arequipa/", label: "la guía de laptop lenta" },
		]}
	/>

	<LandingRelatedPosts
		heading="Artículos relacionados"
		subtitle="Guías y consejos para cuidar tu laptop."
	/>
</BaseLayout>
